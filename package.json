{
  "name": "codex-state-kit-desktop",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "prepare:mihomo": "node ./tools/prepare-mihomo.mjs",
    "prepare:sidecars": "node ./tools/prepare-sidecars.mjs",
    "prepare:prices": "node ./tools/update-bundled-prices.mjs --optional",
    "build": "tauri build",
    "build:renderer": "tsc --noEmit && vite build",
    "icons": "tauri icon frontend/public/icon.svg --output src-tauri/icons && node -e \"require('node:fs').copyFileSync('src-tauri/icons/icon.png', 'src-tauri/icons/source.png')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
